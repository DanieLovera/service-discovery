    {
      "type": "row",
      "title": "Registry operations",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per second by node",
      "targets": [
        {
          "expr": "sum by (instance) (rate(registry_grpc_requests_total[20s]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Errors per second by node and code",
      "targets": [
        {
          "expr": "sum by (instance, code) (rate(registry_grpc_requests_total{code!=\"OK\"}[20s]))",
          "legendFormat": "{{instance}} {{code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
